# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# For SQLite (local development)
DATABASE_URL=sqlite:///./stock_analysis.db

# For PostgreSQL (production)
# DATABASE_URL=postgresql://username:password@localhost:5432/stock_db

# API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IEX_CLOUD_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Analysis Settings
ANALYSIS_REFRESH_INTERVAL=3600  # seconds
SIGNAL_EXPIRY_TIME=86400  # seconds (24 hours)
CONFIDENCE_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds
